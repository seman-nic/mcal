    "version": "0.2.0",
    "configurations": [
        // CAN Debug configuration
        {
            "name": "CAN Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mcal/test/out/${fileBasenameNoExtension}/${fileBasenameNoExtension}.out",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Ceedling: Compile CAN"
        },
        // CAN Run Test configuration
        {
            "name": "CAN Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "ceedling",
            "args": [
                "-m",
                "project_can",
                "test:${fileBasenameNoExtension}"
            ],
            "noDebug": true
        },
        // UART Debug configuration
        {
            "name": "UART Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/mcal/test/out/${fileBasenameNoExtension}/${fileBasenameNoExtension}.out",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Ceedling: Compile UART"
        },
        // UART Run Test configuration
        {
            "name": "UART Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "ceedling",
            "args": [
                "-m",
                "project_uart",
                "test:${fileBasenameNoExtension}"
            ],
            "noDebug": true
        }

    ]
}